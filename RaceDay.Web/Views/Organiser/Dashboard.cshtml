@using System.Text.Json
@{
    ViewData["Title"] = "Organiser Dashboard";
}

<div class="container mt-4">
    <div class="d-flex justify-content-between align-items-center mb-3">
        <h2>Organiser Dashboard</h2>
        <a href="/Organiser/CreateEvent" class="btn btn-success fw-bold">+ Create New Event</a>
    </div>

    @if (ViewBag.Error != null)
    {
        <div class="alert alert-danger">@ViewBag.Error</div>
    }

    <div class="card shadow-sm">
        <div class="card-body">
            <table class="table table-hover mb-0">
                <thead class="table-light">
                    <tr>
                        <th>Event Name</th>
                        <th>Date</th>
                        <th>Location</th>
                        <th>Status</th>
                        <th>Actions</th>
                    </tr>
                </thead>
                <tbody>
                    @if (Model != null && Model.Count > 0)
                    {
                        foreach (var ev in Model)
                        {
                            <tr>
                                <td class="fw-bold">@ev.GetProperty("name").GetString()</td>
                                <td>@ev.GetProperty("eventDate").GetDateTime().ToShortDateString()</td>
                                <td>@ev.GetProperty("location").GetString()</td>
                                <td><span class="badge bg-primary">@ev.GetProperty("status").GetString()</span></td>
                                <td>
                                    <a href="/Organiser/ManageCategories/@ev.GetProperty("eventId").GetInt32()" class="btn btn-sm btn-outline-secondary">Categories</a>
                                    <a href="/Organiser/ViewEnrolments/@ev.GetProperty("eventId").GetInt32()" class="btn btn-sm btn-outline-info">Enrolments</a>
                                </td>
                            </tr>
                        }
                    }
                    else
                    {
                        <tr>
                            <td colspan="5" class="text-center text-muted py-4">You haven't created any events yet.</td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>