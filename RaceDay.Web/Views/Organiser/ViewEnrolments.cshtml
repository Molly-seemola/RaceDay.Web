@using System.Text.Json
@{
    ViewData["Title"] = "Event Enrolments";
}

<div class="container mt-4">
    <!-- Header and Back button -->
    <div class="d-flex justify-content-between align-items-center mb-3">
        <h2>Enrolments: @ViewBag.EventName</h2>
        <a asp-action="Dashboard" class="btn btn-outline-secondary">Back to Dashboard</a>
    </div>

    <!-- Success/Error Messages -->
    @if (TempData["Success"] != null)
    {
        <div class="alert alert-success fw-bold">
            ✅ @TempData["Success"]
        </div>
    }
    @if (TempData["Error"] != null)
    {
        <div class="alert alert-danger fw-bold">
            ❌ @TempData["Error"]
        </div>
    }

    <div class="card shadow-sm">
        <div class="card-body">
            <table class="table table-hover mb-0 align-middle">
                <thead class="table-light">
                    <tr>
                        <th>Participant</th>
                        <th>Category</th>
                        <th>Status</th>
                        <th>Capture Result</th>
                    </tr>
                </thead>
                <tbody>
                    @if (Model != null && Model.Count > 0)
                    {
                        foreach (var enr in Model)
                        {
                            <tr>
                                <td class="fw-bold">
                                    @enr.GetProperty("participantName").GetString()
                                </td>
                                <td>
                                    @enr.GetProperty("categoryName").GetString()
                                </td>
                                <td>
                                    <span class="badge bg-success">
                                        @enr.GetProperty("status").GetString()
                                    </span>
                                </td>
                                <td>
                                    <form method="post" asp-action="SubmitResult" class="d-flex gap-2">
                                        <!-- Hidden fields -->
                                        <input type="hidden" name="enrolmentId" value="@enr.GetProperty("enrolmentId").GetInt32()" />
                                        <input type="hidden" name="eventId" value="@ViewBag.EventId" />
                                        
                                        <!-- Time and Position inputs -->
                                        <input type="text" name="finishTime" class="form-control form-control-sm" placeholder="HH:MM:SS" style="width: 100px;" required />
                                        <input type="number" name="position" class="form-control form-control-sm" placeholder="Position" style="width: 80px;" required />
                                        
                                        <button type="submit" class="btn btn-sm btn-primary fw-bold">Save</button>
                                    </form>
                                </td>
                            </tr>
                        }
                    }
                    else
                    {
                        <tr>
                            <td colspan="4" class="text-center text-muted py-5">
                                <h5>No one has enrolled in this event yet.</h5>
                                <p class="mb-0">When participants enrol, their names will show up here.</p>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>