@using System.Text.Json
@{
    ViewData["Title"] = "My Results";
}

<div class="container mt-4">
    <h2>My Race Results</h2>
    <hr />

    @if (ViewBag.Error != null)
    {
        <div class="alert alert-danger">@ViewBag.Error</div>
    }

    @if (Model == null || Model.Count == 0)
    {
        <div class="alert alert-info">
            You don't have any results yet. Results are added by the Organiser after an event finishes.
        </div>
    }
    else
    {
        <table class="table table-striped table-hover shadow-sm">
            <thead class="table-dark">
                <tr>
                    <th>Event Name</th>
                    <th>Category</th>
                    <th>Finish Time</th>
                    <th>Position</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var res in Model)
                {
                    <tr>
                        <td class="fw-bold">@res.GetProperty("eventName").GetString()</td>
                        <td>@res.GetProperty("categoryName").GetString()</td>
                        <td>
                            @if (res.GetProperty("finishTime").ValueKind != JsonValueKind.Null)
                            {
                                <span class="badge bg-success">@res.GetProperty("finishTime").GetString()</span>
                            }
                            else
                            {
                                <span class="text-muted">Not recorded yet</span>
                            }
                        </td>
                        <td>
                            @if (res.GetProperty("position").ValueKind != JsonValueKind.Null)
                            {
                                <span class="fw-bold">@res.GetProperty("position").GetInt32()</span>
                            }
                            else
                            {
                                <span class="text-muted">-</span>
                            }
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    }
</div>