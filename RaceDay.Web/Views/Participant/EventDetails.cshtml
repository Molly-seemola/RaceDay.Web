@using System.Text.Json
@{
    ViewData["Title"] = "Event Details";
}

<div class="container mt-4">
    <div class="card shadow">
        <div class="card-header bg-primary text-white">
            <h2>@Model.GetProperty("name").GetString()</h2>
        </div>
        <div class="card-body">
            <p><strong>Location:</strong> @Model.GetProperty("location").GetString()</p>
            <p><strong>Date:</strong> @Model.GetProperty("eventDate").GetDateTime().ToShortDateString()</p>
            
            <hr />
            <h4>Select a Category to Enter:</h4>
            
            <div class="row mt-3">
                @if (ViewBag.Categories != null)
                {
                    foreach (var cat in ViewBag.Categories)
                    {
                        <div class="col-md-4 mb-3">
                            <div class="card border-success">
                                <div class="card-body">
                                    <h5>@cat.GetProperty("categoryName").GetString()</h5>
                                    <p class="mb-1">Distance: @cat.GetProperty("distance").GetDecimal() km</p>
                                    <p class="mb-3">Fee: R @cat.GetProperty("entryFee").GetDecimal()</p>
                                    
                                    <form method="post" asp-action="Enrol">
                                        <input type="hidden" name="eventId" value="@Model.GetProperty("eventId").GetInt32()" />
                                        <input type="hidden" name="categoryId" value="@cat.GetProperty("categoryId").GetInt32()" />
                                        <button type="submit" class="btn btn-success w-100">Sign Up</button>
                                    </form>
                                </div>
                            </div>
                        </div>
                    }
                }
            </div>
        </div>
    </div>
</div>